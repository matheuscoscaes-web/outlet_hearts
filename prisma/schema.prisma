generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model OutletTimer {
  id              String    @id @default("singleton")
  startedAt       DateTime?
  durationMinutes Int       @default(180)
  updatedAt       DateTime  @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(OPERATOR)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stockLogs        StockLog[]
  variantStockLogs VariantStockLog[]
}

enum AdminRole {
  SUPER_ADMIN
  OPERATOR
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  shortDescription String
  description      String           @db.Text
  category         String
  brand            String?
  sizes            String[]         @default([])
  colors           String[]         @default([])
  condition        ProductCondition
  originalPrice    Decimal          @db.Decimal(10, 2)
  outletPrice      Decimal          @db.Decimal(10, 2)
  status           ProductStatus    @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  images       ProductImage[]
  stock        Stock?
  variants     ProductVariant[]
  reservations Reservation[]
  orderItems   OrderItem[]
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  SOLD_OUT
}

enum ProductCondition {
  NEW
  LIKE_NEW
  STOCK_END
  UNIQUE_PIECE
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  color     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Stock {
  id               String   @id @default(cuid())
  productId        String   @unique
  quantityTotal    Int      @default(0)
  quantityReserved Int      @default(0)
  quantitySold     Int      @default(0)
  updatedAt        DateTime @updatedAt

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  logs    StockLog[]
}

model StockLog {
  id          String   @id @default(cuid())
  stockId     String
  adminUserId String?
  reason      String
  delta       Int
  note        String?
  createdAt   DateTime @default(now())

  stock     Stock      @relation(fields: [stockId], references: [id])
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id])
}

// Estoque por cor — opcional. Um produto só passa a usar esse fluxo
// quando o admin cadastra pelo menos uma variante (cor + quantidade)
// para ele; produtos sem nenhuma linha aqui continuam usando o Stock
// (por produto) de sempre, sem qualquer mudança de comportamento.
model ProductVariant {
  id               String   @id @default(cuid())
  productId        String
  color            String
  quantityTotal    Int      @default(0)
  quantityReserved Int      @default(0)
  quantitySold     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  logs         VariantStockLog[]
  reservations Reservation[]
  orderItems   OrderItem[]

  @@unique([productId, color])
}

model VariantStockLog {
  id          String   @id @default(cuid())
  variantId   String
  adminUserId String?
  reason      String
  delta       Int
  note        String?
  createdAt   DateTime @default(now())

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  adminUser AdminUser?     @relation(fields: [adminUserId], references: [id])
}

model Reservation {
  id               String            @id @default(cuid())
  productId        String
  productVariantId String?
  quantity         Int
  status           ReservationStatus @default(ACTIVE)
  clientToken      String
  expiresAt        DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  product        Product         @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
  order          Order?

  @@index([status, expiresAt])
  @@index([clientToken])
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  CANCELLED
}

model Order {
  id             String              @id @default(cuid())
  reservationId  String              @unique
  status         OrderStatus         @default(PENDING)
  deliveryMethod OrderDeliveryMethod @default(SHIPPING)
  customerName   String
  customerEmail  String
  customerPhone  String?
  customerCpf    String?
  groupNumber    String?

  shippingCep          String?
  shippingStreet       String?
  shippingNumber       String?
  shippingComplement   String?
  shippingNeighborhood String?
  shippingCity         String?
  shippingState        String?

  meCartId      String?
  meServiceId   Int?
  meServiceName String?
  meLabelUrl    String?
  meGeneratedAt DateTime?

  totalAmount   Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id])
  items       OrderItem[]
  payment     Payment?
}

enum OrderDeliveryMethod {
  SHIPPING
  PICKUP
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productId        String
  productVariantId String?
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  totalPrice       Decimal @db.Decimal(10, 2)

  order          Order           @relation(fields: [orderId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  gatewayId       String?
  gateway         String        @default("mercadopago")
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(10, 2)
  method          String?
  gatewayResponse Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REFUNDED
}
